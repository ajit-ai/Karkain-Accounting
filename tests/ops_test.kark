// Round 2 operations tests for Karkain Accounting (self-contained, in-memory).

func test_trial_balance_totals() {
    let lines = ["LINE|J001|1000|5000|0", "LINE|J001|2000|0|5000", "LINE|J002|1000|1000|0", "LINE|J002|3000|0|1000"]
    let posted = ["J001", "J002"]
    let d = 0
    let c = 0
    let i = 0
    while (i < len(lines)) {
        let f = split(lines[i], "|")
        let ok = 0
        let j = 0
        while (j < len(posted)) {
            if (f[1] == posted[j]) { ok = 1 }
            j = j + 1
        }
        if (ok == 1) {
            if (f[2] == "1000") { d = d + int(f[3]) }
            if (f[2] == "2000") { c = c + int(f[4]) }
            if (f[2] == "3000") { c = c + int(f[4]) }
        }
        i = i + 1
    }
    assert_eq(d, 6000)
    assert_eq(c, 6000)
    assert_eq(d - c, 0)
}

func test_posting_controls() {
    let errors = ["ERROR|J001|duplicate_ref|-", "ERROR|J003|unbalanced|-", "ERROR|J004|closed_period|-"]
    let dup = 0
    let unbal = 0
    let closed = 0
    let i = 0
    while (i < len(errors)) {
        let f = split(errors[i], "|")
        if (f[2] == "duplicate_ref") { dup = dup + 1 }
        if (f[2] == "unbalanced") { unbal = unbal + 1 }
        if (f[2] == "closed_period") { closed = closed + 1 }
        i = i + 1
    }
    assert_eq(dup, 1)
    assert_eq(unbal, 1)
    assert_eq(closed, 1)
    let d = 100
    let c = 90
    let balanced = 0
    if (d == c) { balanced = 1 }
    assert_eq(balanced, 0)
}

func test_ledger_listing_and_error_records() {
    let ledger = ["LEDGER_LINE code=1000 ref=J001 debit=5000 credit=0", "LEDGER_LINE code=1000 ref=J002 debit=1000 credit=0", "LEDGER code=1000 name=Cash entries=2 debit=6000 credit=0 net=6000"]
    let cash_lines = 0
    let i = 0
    while (i < len(ledger)) {
        if (contains(ledger[i], "code=1000") == 1) { cash_lines = cash_lines + 1 }
        i = i + 1
    }
    assert_eq(cash_lines, 3)
    let err = split("ERROR|J003|unbalanced|-", "|")
    assert_eq(err[0], "ERROR")
    assert_eq(err[1], "J003")
    assert_eq(err[2], "unbalanced")
}
