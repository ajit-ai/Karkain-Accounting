func test_line_totals() {
    let recs = ["LINE|J001|1000|5000|0", "LINE|J001|2000|0|5000", "LINE|J002|1000|900|0", "LINE|J002|3000|0|1000"]
    let d1 = 0
    let c1 = 0
    let d2 = 0
    let c2 = 0
    let i = 0
    while (i < len(recs)) {
        let f = split(recs[i], "|")
        if (f[1] == "J001") { d1 = d1 + int(f[3]); c1 = c1 + int(f[4]) }
        if (f[1] == "J002") { d2 = d2 + int(f[3]); c2 = c2 + int(f[4]) }
        i = i + 1
    }
    assert_eq(d1, 5000)
    assert_eq(c1, 5000)
    assert_eq(d2, 900)
    assert_eq(c2, 1000)
}

func test_validate_gate() {
    let d = 5000
    let c = 5000
    let ok = 0
    if (d == c) { ok = 1 }
    let d2 = 900
    let c2 = 1000
    let bad = 0
    if (d2 == c2) { bad = 1 }
    assert_eq(ok, 1)
    assert_eq(bad, 0)
    let rec = "LINE|J001|1000|5000|0"
    let f = split(rec, "|")
    assert_eq(int(f[3]), 5000)
    assert_eq(int(f[4]), 0)
}

func test_posted_balance_net() {
    let lines = ["LINE|J001|1000|5000|0", "LINE|J001|2000|0|5000", "LINE|J002|1000|900|0"]
    let posted = ["J001"]
    let d = 0
    let c = 0
    let i = 0
    while (i < len(lines)) {
        let f = split(lines[i], "|")
        let is_posted = 0
        let j = 0
        while (j < len(posted)) {
            if (f[1] == posted[j]) { is_posted = 1 }
            j = j + 1
        }
        if (is_posted == 1) {
            if (f[2] == "1000") { d = d + int(f[3]); c = c + int(f[4]) }
        }
        i = i + 1
    }
    assert_eq(d, 5000)
    assert_eq(c, 0)
    assert_eq(d - c, 5000)
}
