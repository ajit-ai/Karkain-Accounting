// Karkain Accounting - first functional slice.
// Chart of accounts, journals, balanced-line validation, posting and
// balance queries. Builtins only; all paths are relative to the repo root.
// "net" is defined purely as debits minus credits (an arithmetic position).
import acct_controls

func find_rec(state, kind, key) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) {
            if (f[1] == key) { return state[i] }
        }
        i = i + 1
    }
    return ""
}

func count_kind(state, kind) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

func append_rec(state, rec) {
    let out = []
    let i = 0
    while (i < len(state)) { push(out, state[i]); i = i + 1 }
    push(out, rec)
    return out
}

func upsert_account(state, code, name) {
    let rec = "ACCOUNT|" + code + "|" + name
    let out = []
    let i = 0
    let replaced = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "ACCOUNT") {
            if (f[1] == code) { push(out, rec); replaced = 1 }
            else { push(out, state[i]) }
        } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func add_journal(state, jref) {
    if (find_rec(state, "JOURNAL", jref) != "") { return state }
    return append_rec(state, "JOURNAL|" + jref)
}

func has_line(state, jref, code, debit, credit) {
    let d = str(debit)
    let c = str(credit)
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "LINE") {
            if (f[1] == jref) {
                if (f[2] == code) {
                    if (f[3] == d) {
                        if (f[4] == c) { return 1 }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

func add_line(state, jref, code, debit, credit) {
    if (find_rec(state, "JOURNAL", jref) == "") {
        print("LINE " + jref + " FAIL unknown_journal")
        return state
    }
    if (find_rec(state, "ACCOUNT", code) == "") {
        print("LINE " + jref + " FAIL unknown_account " + code)
        return state
    }
    if (has_line(state, jref, code, debit, credit) == 1) { return state }
    let rec = "LINE|" + jref + "|" + code + "|" + str(debit) + "|" + str(credit)
    return append_rec(state, rec)
}

func sum_field(state, jref, field) {
    let total = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "LINE") {
            if (f[1] == jref) {
                if (field == "debit") { total = total + int(f[3]) }
                if (field == "credit") { total = total + int(f[4]) }
            }
        }
        i = i + 1
    }
    return total
}

func is_posted(state, jref) {
    if (find_rec(state, "POSTED", jref) != "") { return 1 }
    return 0
}

func validate(state, jref) {
    if (find_rec(state, "JOURNAL", jref) == "") {
        print("VALIDATE " + jref + " FAIL unknown_journal")
        return 0
    }
    let d = sum_field(state, jref, "debit")
    let c = sum_field(state, jref, "credit")
    if (d == c) {
        print("VALIDATE " + jref + " OK debits=" + str(d) + " credits=" + str(c))
        return 1
    }
    print("VALIDATE " + jref + " FAIL debits=" + str(d) + " credits=" + str(c))
    return 0
}

func post(state, jref) {
    if (find_rec(state, "JOURNAL", jref) == "") {
        print("POST " + jref + " FAIL unknown_journal")
        return state
    }
    if (is_posted(state, jref) == 1) {
        print("POST " + jref + " already_posted")
        return state
    }
    let d = sum_field(state, jref, "debit")
    let c = sum_field(state, jref, "credit")
    if (d != c) {
        print("POST " + jref + " FAIL unbalanced debits=" + str(d) + " credits=" + str(c))
        return state
    }
    print("POST " + jref + " OK posted=1")
    return append_rec(state, "POSTED|" + jref)
}

func balance(state, code) {
    let acct = find_rec(state, "ACCOUNT", code)
    if (acct == "") {
        print("BALANCE " + code + " FAIL unknown_account")
        return
    }
    let a = split(acct, "|")
    let name = a[2]
    let d = 0
    let c = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "LINE") {
            if (f[2] == code) {
                if (is_posted(state, f[1]) == 1) {
                    d = d + int(f[3])
                    c = c + int(f[4])
                }
            }
        }
        i = i + 1
    }
    let net = d - c
    print("BALANCE " + code + " " + name + " debits=" + str(d) + " credits=" + str(c) + " net=" + str(net))
}

func persist(path, state) {
    let out = ""
    let i = 0
    while (i < len(state)) { out = out + state[i] + "\n"; i = i + 1 }
    writeFile(path, out)
}

func main() {
    let cmd_path = "data/commands.dat"
    let state_path = "data/state.dat"
    let report_path = "data/report.dat"
    let txt = readFile(cmd_path)
    let cmds = split(txt, "\n")
    let state = split(readFile(state_path), "\n")
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = trim(f[0])
            if (op == "ACCOUNT") {
                let code = trim(f[1])
                let name = trim(f[2])
                state = upsert_account(state, code, name)
                report = report + "ACCOUNT " + code + " " + name + "\n"
                print("ACCOUNT " + code + " " + name)
            }
            if (op == "JOURNAL") {
                let jref = trim(f[1])
                state = add_journal(state, jref)
                report = report + "JOURNAL " + jref + "\n"
                print("JOURNAL " + jref)
            }
            if (op == "LINE") {
                let jref = trim(f[1])
                let code = trim(f[2])
                let debit = int(trim(f[3]))
                let credit = int(trim(f[4]))
                state = add_line(state, jref, code, debit, credit)
                report = report + "LINE " + jref + " " + code + " " + str(debit) + " " + str(credit) + "\n"
                print("LINE " + jref + " " + code + " " + str(debit) + " " + str(credit))
            }
            if (op == "VALIDATE") {
                let jref = trim(f[1])
                validate(state, jref)
                report = report + "VALIDATE " + jref + "\n"
            }
            if (op == "POST") {
                let jref = trim(f[1])
                state = post(state, jref)
                report = report + "POST " + jref + "\n"
            }
            if (op == "BALANCE") {
                let code = trim(f[1])
                balance(state, code)
                report = report + "BALANCE " + code + "\n"
            }
        }
        i = i + 1
    }
    persist(state_path, state)
    persist(report_path, split(report, "\n"))
    print("ACCOUNTING_OK accounts=" + str(count_kind(state, "ACCOUNT")) + " journals=" + str(count_kind(state, "JOURNAL")) + " lines=" + str(count_kind(state, "LINE")) + " posted=" + str(count_kind(state, "POSTED")))
    acct_controls.acct2_run()
}
